#!/bin/sh
set -e

echo "[CAELUS-HOOK] Verifying 3rd-Party Repositories (Microsoft VS Code & Docker CE)..."

mkdir -p /etc/apt/keyrings

# Microsoft VS Code Key
if [ ! -f /etc/apt/keyrings/packages.microsoft.gpg ]; then
    curl -sSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /etc/apt/keyrings/packages.microsoft.gpg || true
fi

# Docker Key
if [ ! -f /etc/apt/keyrings/docker.gpg ]; then
    curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg || true
fi

apt-get update || true
