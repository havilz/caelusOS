#!/bin/sh
set -e

echo "[CAELUS-HOOK] Setting up 3rd-Party Repositories (Microsoft VS Code & Docker CE)..."

# Setup Microsoft VS Code Repo
if [ ! -f /etc/apt/sources.list.d/vscode.list ]; then
    mkdir -p /etc/apt/keyrings
    curl -sSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /etc/apt/keyrings/packages.microsoft.gpg || true
    echo "deb [arch=amd64,arm64,armhf signed-by=/etc/apt/keyrings/packages.microsoft.gpg] https://packages.microsoft.com/repos/code stable main" > /etc/apt/sources.list.d/vscode.list || true
fi

# Setup Docker CE Repo
if [ ! -f /etc/apt/sources.list.d/docker.list ]; then
    mkdir -p /etc/apt/keyrings
    curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg || true
    echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable" > /etc/apt/sources.list.d/docker.list || true
fi

apt-get update || true
