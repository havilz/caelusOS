label live-@FLAVOUR@
	menu label ^CaelusOS Live (@FLAVOUR@)
	menu default
	kernel @KERNEL@
	append initrd=@INITRD@ boot=live components quiet splash @LB_BOOTAPPEND_LIVE@

label live-@FLAVOUR@-failsafe
	menu label ^CaelusOS Live (@FLAVOUR@ failsafe)
	kernel @KERNEL@
	append initrd=@INITRD@ boot=live components nomodeset noapic noacpi nosplash @LB_BOOTAPPEND_LIVE@ @LB_BOOTAPPEND_FAILSAFE@
